{
  "name": "@antelopejs/nodemailer",
  "version": "0.0.3",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "prepack": "pnpm run build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm run build && ajs module test .",
    "release": "pnpm run lint && pnpm run prepack && release-it"
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-email"
    ],
    "test": "src/test/antelope.test.ts"
  },
  "dependencies": {
    "@antelopejs/interface-core": "^0.0.6",
    "@antelopejs/interface-email": "^0.0.4",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^6.4.23",
    "@types/sinon": "^21.0.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.3",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.8.1"
}
