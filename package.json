{
  "name": "@antelopejs/nodemailer",
  "version": "0.0.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev:prepare": "cd playground && ajs module imports install",
    "dev": "ajs project run -w -p playground",
    "generate": "ajs module exports generate",
    "prepare": "ajs module imports install",
    "prepack": "pnpm run build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "ajs module test ."
  },
  "antelopeJs": {
    "exportsPath": "dist/interfaces",
    "imports": [
      "core@beta",
      "logging@beta"
    ],
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "importsOptional": [],
    "test": {
      "project": "src/test/antelope.test.json",
      "folder": "dist/test"
    }
  },
  "dependencies": {
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "rimraf": "^6.0.1",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.0",
    "@types/sinon": "^21.0.0",
    "chai": "^6.2.1",
    "sinon": "^21.0.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.8.1"
}
