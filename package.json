{
  "name": "@antelopejs/nodemailer",
  "version": "0.0.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -fr dist && tsc",
    "dev:prepare": "cd playground && ajs module imports install",
    "dev": "ajs project run -w -p playground",
    "generate": "ajs module exports generate",
    "prepare": "ajs module imports install",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "antelopeJs": {
    "exportsPath": "dist/interfaces",
    "imports": [
      "core@beta"
    ],
    "baseUrl": "dist",
    "paths": {
      "@/*": [
        "*"
      ]
    },
    "importsOptional": []
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.8.1"
}
