{
  "cacheFolder": ".antelope/cache",
  "logging": {
    "channelFilter": {
      "*": "INFO"
    }
  },
  "modules": {
    "local": {
      "source": {
        "type": "local",
        "path": "."
      },
      "config": {
        "host": "smtp.example.com",
        "port": 587,
        "secure": false,
        "defaults": {
          "from": "noreply@example.com"
        }
      }
    }
  }
}
